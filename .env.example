# --- Station identity, sent to p-points.com ---
STN_ID=S-24001
ACCOUNT_CODE=X-7689
BANK_SENDER_ID=756697110107
STN_KEY=CHANGEME_STN_KEY_NOT_YET_ISSUED
TARGET_URL=https://p-points.com/sms_add.php

# --- Gmail (IMAP) ---
# GMAIL_APP_PASSWORD is a Google App Password, not the account password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step
# Verification enabled) and paste it here. Keep it out of git: .env.local is
# already ignored.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
BANK_EMAIL_FROM=no-reply@kasikornbank.com
GMAIL_MAILBOX=INBOX

# Shared secret guarding /api/poll. Generate one with:
#   node -e "console.log(crypto.randomUUID())"
POLL_SECRET=CHANGEME_GENERATE_A_RANDOM_SECRET

# Text that must appear in an alert for it to be trusted. Use the LINE account
# name as it appears in the notification title — for Kasikorn that is
# "KBank LIVE", so "KBank" matches. NOT "K PLUS": those words appear only on a
# button inside the chat bubble, which the Android notification does not carry.
# MacroDroid forwards every LINE notification, so without this anyone who can
# message the phone could fake a transaction.
# Leave empty only while discovering the real notification wording.
REQUIRE_SENDER=KBank

# --- Supabase (optional) ---
# Logs every attempt to forward to p-points.com, viewable at /logs. Leave both
# empty to skip logging entirely — forwarding still works without it.
# Project URL and service_role key: Project Settings → API. Run
# supabase/schema.sql once in the SQL editor to create the table first.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGEME_SERVICE_ROLE_KEY
