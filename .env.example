# --- Station identity, sent to p-points.com ---
STN_ID=S-24001
ACCOUNT_CODE=X-7689
BANK_SENDER_ID=756697110107
STN_KEY=CHANGEME_STN_KEY_NOT_YET_ISSUED
TARGET_URL=https://p-points.com/sms_add.php

# --- Gmail (IMAP) ---
# GMAIL_APP_PASSWORD is a Google App Password, not the account password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step
# Verification enabled) and paste it here. Keep it out of git: .env.local is
# already ignored.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
BANK_EMAIL_FROM=no-reply@kasikornbank.com
GMAIL_MAILBOX=INBOX

# Shared secret guarding /api/poll. Generate one with:
#   node -e "console.log(crypto.randomUUID())"
POLL_SECRET=CHANGEME_GENERATE_A_RANDOM_SECRET

# Text that must appear in an alert for it to be trusted — the bank's name as
# it shows in the notification. MacroDroid forwards every LINE notification, so
# without this anyone who can message you could fake a transaction.
# Leave empty only while discovering the real notification wording.
REQUIRE_SENDER=K PLUS
